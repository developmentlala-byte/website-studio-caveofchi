{
	"version": 3,
	"routes": [
		{
			"src": "^/(.*)/$",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/_image$",
			"dest": "_render"
		},
		{
			"src": "^/404$",
			"dest": "_render"
		},
		{
			"src": "^/about$",
			"dest": "_render"
		},
		{
			"src": "^/booking/after-payment$",
			"dest": "_render"
		},
		{
			"src": "^/booking/status$",
			"dest": "_render"
		},
		{
			"src": "^/experiences/([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/experiences$",
			"dest": "_render"
		},
		{
			"src": "^/faq$",
			"dest": "_render"
		},
		{
			"src": "^/robots\\.txt$",
			"dest": "_render"
		},
		{
			"src": "^/schedule$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap-index\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/studios/([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}