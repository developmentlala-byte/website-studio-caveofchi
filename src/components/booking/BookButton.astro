---
import type { CaveEvent } from '@/lib/events';
import { formatDateShort, formatTime } from '@/lib/format';

type EventSession = CaveEvent['data']['sessions'][number];
interface Props { event: CaveEvent; variant?: 'solid' | 'outline'; session: EventSession }
const { event, variant = 'solid', session } = Astro.props;
const d = event.data;
const soldOut = session.seatsLeft <= 0;
const meta = `${session.studioName} · ${formatDateShort(session.startsAt)} · ${formatTime(session.startsAt)} WIB`;
---
<button type="button" class:list={['book', variant]} data-book
  data-session-id={session.sessionId} data-event-slug={event.id}
  data-studio-slug={session.space}
  data-title={d.title} data-meta={meta}
  data-price={session.price} data-seats={session.seatsLeft}
  data-bookable={session.isBookable}
  data-available-label={variant === 'outline' ? 'Book ↗' : 'Pesan sekarang ↗'}
  disabled={soldOut || !session.isBookable}>
  {soldOut ? 'Kuota habis' : <slot>Pesan sekarang ↗</slot>}
</button>
<style>
  .book {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 10px 13px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition: background 180ms ease, color 180ms ease;
  }

  .solid {
    background: var(--umber);
    color: var(--paper-light);
  }

  .solid:hover:not(:disabled) {
    background: var(--clay);
  }

  .outline {
    border-color: var(--line);
    background: transparent;
    color: var(--umber);
  }

  .outline:hover:not(:disabled) {
    border-color: var(--umber);
    background: var(--umber);
    color: var(--paper-light);
  }

  .book:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .book {
      transition: none;
    }
  }
</style>