---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createT, localizedPath, toLocale } from "@/i18n";
import { messages } from "./BookingStatus.messages";
const locale = toLocale(Astro.currentLocale);
const t = createT(locale, messages);
---
<BaseLayout
  title={t("seoTitle")}
  description={t("seoDescription")}
  noindex
>
  <section class="booking-page section container" aria-labelledby="booking-title" data-booking-page>
    <div class="eyebrow">Booking · Midtrans</div>
    <h1 id="booking-title" class="heading">{t("title")}</h1>
    <p class="lead" data-message aria-live="polite">
      {t("checking")}
    </p>
    <span
      hidden
      data-booking-labels
      data-missing-reference={t("missingReference")}
      data-paid={t("paid")}
      data-pending={t("pending")}
      data-expired={t("expired")}
      data-failed={t("failed")}
      data-guest={t("guest")}
      data-confirmed={t("confirmed")}
      data-review={t("review")}
      data-payment-failed={t("paymentFailed")}
      data-processing={t("processing")}
      data-awaiting-confirmation={t("awaitingConfirmation")}
      data-status-unavailable={t("statusUnavailable")}
    ></span>
    <dl class="booking-details" data-details hidden>
      <div><dt>{t("bookingCode")}</dt><dd data-code></dd></div>
      <div><dt>{t("paymentStatus")}</dt><dd data-payment-status></dd></div>
      <div><dt>Event</dt><dd data-event></dd></div>
      <div><dt>{t("studio")}</dt><dd data-studio></dd></div>
      <div><dt>{t("schedule")}</dt><dd data-date></dd></div>
      <div><dt>{t("guestCount")}</dt><dd data-quantity></dd></div>
      <div><dt>{t("pricePerGuest")}</dt><dd data-unit-price></dd></div>
      <div><dt>{t("totalPayment")}</dt><dd data-total></dd></div>
    </dl>
    <div class="status-actions">
      <a class="receipt-link" data-receipt hidden target="_blank" rel="noopener noreferrer">
        {t("receipt")}
      </a>
      <button type="button" data-retry hidden>{t("retry")}</button>
      <a href={localizedPath(locale, "/experiences")}>{t("moreEvents")}</a>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    BookingError,
    bookingReceiptUrl,
    fetchBookingStatus,
  } from "@/lib/api/bookings";
  import { formatIDR, formatDateShort, formatTime } from "@/lib/format";

  const locale = document.documentElement.lang === "en" ? "en" : "id";
  const labelsElement = document.querySelector<HTMLElement>("[data-booking-labels]");
  if (!labelsElement) throw new Error("Booking status labels are missing.");
  const label = (key: string): string => {
    const value = labelsElement.dataset[key];
    if (value === undefined) throw new Error(`Missing booking status label: ${key}`);
    return value;
  };
  const message = document.querySelector<HTMLElement>("[data-message]");
  const details = document.querySelector<HTMLDListElement>("[data-details]");
  const retryButton = document.querySelector<HTMLButtonElement>("[data-retry]");
  const receiptLink = document.querySelector<HTMLAnchorElement>("[data-receipt]");
  const reference = new URLSearchParams(window.location.search).get("reference");
  let checking = false;
  let attempts = 0;

  const setText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };

  const checkStatus = async () => {
    if (checking) return;
    checking = true;
    if (retryButton) retryButton.disabled = true;

    if (!reference) {
      if (message) message.textContent = label("missingReference");
      checking = false;
      if (retryButton) retryButton.hidden = false;
      return;
    }

    try {
      const booking = await fetchBookingStatus(reference);
      if (details) details.hidden = false;
      if (retryButton) retryButton.hidden = true;
      setText("[data-code]", booking.code);
      setText("[data-payment-status]", booking.paymentStatus === "paid"
        ? label("paid")
        : booking.paymentStatus === "pending"
          ? label("pending")
          : booking.paymentStatus === "expired"
            ? label("expired")
            : label("failed"));
      setText("[data-event]", booking.eventName);
      setText("[data-studio]", booking.studioName);
      setText("[data-date]", `${formatDateShort(new Date(booking.startsAt), locale)} · ${formatTime(new Date(booking.startsAt), locale)} WIB`);
      setText("[data-quantity]", `${booking.quantity} ${label("guest")}`);
      setText("[data-unit-price]", `${formatIDR(booking.unitPrice, locale)} / ${label("guest")}`);
      setText("[data-total]", formatIDR(booking.totalAmount, locale));
      if (receiptLink) {
        receiptLink.href = bookingReceiptUrl(booking.code);
        receiptLink.hidden = booking.paymentStatus !== "paid";
      }

      if (booking.bookingStatus === "confirmed" && booking.paymentStatus === "paid") {
        if (message) message.textContent = label("confirmed");
        attempts = 20;
      } else if (booking.bookingStatus === "payment_review") {
        if (message) message.textContent = label("review");
        attempts = 20;
      } else if (["expired", "cancelled"].includes(booking.bookingStatus) || booking.paymentStatus === "failed") {
        if (message) message.textContent = label("paymentFailed");
        attempts = 20;
      } else if (attempts < 20) {
        if (message) message.textContent = label("processing");
        attempts += 1;
        window.setTimeout(() => void checkStatus(), 3000);
      } else {
        if (message) message.textContent = label("awaitingConfirmation");
        if (retryButton) retryButton.hidden = false;
      }
    } catch (error) {
      if (message) {
        message.textContent = error instanceof BookingError
          ? error.message
          : label("statusUnavailable");
      }
      if (retryButton) retryButton.hidden = false;
    } finally {
      checking = false;
      if (retryButton) retryButton.disabled = false;
    }
  };

  retryButton?.addEventListener("click", () => {
    attempts = 0;
    void checkStatus();
  });
  void checkStatus();
</script>

<style>
  .booking-page {
    min-height: 60vh;
  }

  .booking-page .heading {
    margin: 12px 0;
  }

  .lead {
    max-width: 650px;
    color: var(--muted);
    line-height: 1.8;
  }

  .booking-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 30px 0;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .booking-details[hidden] {
    display: none;
  }

  .booking-details div {
    min-width: 0;
  }

  .booking-details dt {
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 10px;
  }

  .booking-details dd {
    margin: 0;
    color: var(--umber);
    font-size: 13px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .status-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .status-actions button {
    min-height: 42px;
    padding: 10px 16px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--umber);
    color: var(--paper-light);
    cursor: pointer;
  }

  .status-actions a {
    color: var(--umber);
    font-size: 12px;
  }

  .status-actions .receipt-link {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    background: var(--umber);
    color: var(--paper-light);
  }

  @media (max-width: 600px) {
    .booking-details {
      grid-template-columns: 1fr;
      padding: 16px;
    }
  }
</style>
