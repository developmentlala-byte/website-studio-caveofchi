---
import EventCard from '@/components/events/EventCard.astro';
import type { CaveEvent } from '@/lib/events';
import type { PublicStudio } from '@/lib/api/studios';
import { createT, toLocale } from '@/i18n';
import { messages } from './EventBrowser.messages';

interface Props { events: CaveEvent[]; studios: PublicStudio[]; showIntro?: boolean }
const { events, studios, showIntro = true } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = createT(locale, messages);
---
<div data-event-browser>
  {showIntro && (
    <div class="section-head event-head">
      <div class="event-head-main">
        <div class="eyebrow">03 / {t('eyebrow')}</div>
        <h2 class="heading">{t('findYour')} <em class="script">{t('class')}</em>.</h2>
        <p class="head-lead">
          {t('trySomething')}
        </p>
      </div>
      <div class="head-badge">
        <span class="head-badge-dot" aria-hidden="true"></span>
        {t('beginnerFriendly')}
      </div>
    </div>
  )}
  {events.length > 0 && studios.length > 0 && (
    <div class="filter-row studio-filter-row" role="group" aria-label={t('filterStudios')}>
      <button type="button" class="filter active" data-studio-filter="all" aria-pressed="true">{t('allStudios')}</button>
      {studios.map((studio) => (
        <button type="button" class="filter" data-studio-filter={studio.slug} aria-pressed="false">
          {studio.name}
        </button>
      ))}
    </div>
  )}
  <div class="event-grid">
    {events.map((event) => <EventCard event={event} />)}
  </div>
  <nav class="event-pagination" aria-label={t('pagination')} data-event-pagination hidden>
    <button type="button" data-event-previous>{t('previous')}</button>
    <span data-event-page aria-live="polite"></span>
    <button type="button" data-event-next>{t('next')}</button>
  </nav>
  <p class="empty-state" data-empty hidden={events.length > 0}>
    {t('noEvents')}
  </p>
</div>

<style>
  /* ---------- Header: eyebrow + heading + lead (kiri), badge (kanan) ---------- */
  .event-head {
    align-items: flex-end;
  }

  .event-head .eyebrow {
    margin-bottom: 18px;
  }

  .event-head .heading {
    margin: 0;
  }

  .event-head .head-lead {
    max-width: 300px;
    margin: 18px 0 0;
    color: var(--umber);
    font-size: 13px;
    line-height: 1.75;
  }

  .head-badge {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 12px;
    padding: 11px 18px;
    border: 1px solid var(--line);
    border-radius: 99px;
    color: var(--umber);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .head-badge-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #c4a88a;
  }

  /* ---------- Filter ---------- */
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-3);
  }

  .filter {
    padding: 10px 13px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: transparent;
    color: #6b6055;
    cursor: pointer;
    font-size: 11px;
    font-weight: 400;
    line-height: normal;
  }

  .filter.active {
    border-color: var(--umber);
    background: var(--umber);
    color: #fff;
  }

  .studio-filter-row {
    margin-top: calc(var(--space-3) * -1);
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .empty-state {
    padding: var(--space-4);
    color: var(--muted);
    text-align: center;
  }

  .event-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 26px auto 0;
    color: var(--umber);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .event-pagination[hidden] {
    display: none;
  }

  .event-pagination button {
    padding: 12px 20px;
    border: 1px solid var(--umber);
    background: transparent;
    color: var(--umber);
    cursor: pointer;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-pagination button:hover:not(:disabled) {
    background: var(--umber);
    color: var(--paper-light);
  }

  .event-pagination button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  @media (max-width: 900px) {
    .event-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 740px) {
    .event-head {
      align-items: flex-start;
    }

    .head-badge {
      white-space: normal;
    }
  }

  @media (max-width: 620px) {
    .event-grid {
      grid-template-columns: 1fr;
    }

    .filter-row {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 2px 2px 8px;
    }

    .filter {
      flex: 0 0 auto;
    }
  }
</style>

<script>
  import { createT, type Locale } from '@/i18n';
  import { messages } from './EventBrowser.messages';
  import { getDurationParts } from '@/lib/format';

  const locale: Locale = document.documentElement.lang === 'en' ? 'en' : 'id';
  const t = createT(locale, messages);
  const intlLocale = locale === 'en' ? 'en-US' : 'id-ID';

  document.querySelectorAll<HTMLElement>('[data-event-browser]').forEach((root) => {
    const studioButtons = root.querySelectorAll<HTMLButtonElement>('[data-studio-filter]');
    const cards = root.querySelectorAll<HTMLElement>('[data-event-card]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const pagination = root.querySelector<HTMLElement>('[data-event-pagination]');
    const previousButton = root.querySelector<HTMLButtonElement>('[data-event-previous]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-event-next]');
    const pageLabel = root.querySelector<HTMLElement>('[data-event-page]');
    const pageSize = 6;
    let currentPage = 1;
    let selectedStudio = 'all';
    const unavailableEventSlugs = new Set<string>();

    type CardSession = {
      sessionId: string;
      startsAt: string;
      durationMinutes: number;
      price: number;
      seatsLeft: number;
      studioSlug: string;
      studioName: string;
      registrationOpensAt: string | null;
      isBookable: boolean;
      salesStatus: 'coming_soon' | 'open' | 'sold_out' | 'closed';
    };

    const isCardSession = (value: unknown): value is CardSession =>
      typeof value === 'object' &&
      value !== null &&
      'sessionId' in value &&
      typeof value.sessionId === 'string' &&
      'startsAt' in value &&
      typeof value.startsAt === 'string' &&
      Number.isFinite(Date.parse(value.startsAt)) &&
      'durationMinutes' in value &&
      typeof value.durationMinutes === 'number' &&
      'price' in value &&
      typeof value.price === 'number' &&
      'seatsLeft' in value &&
      typeof value.seatsLeft === 'number' &&
      'studioSlug' in value &&
      typeof value.studioSlug === 'string' &&
      'studioName' in value &&
      typeof value.studioName === 'string' &&
      'registrationOpensAt' in value &&
      (value.registrationOpensAt === null || typeof value.registrationOpensAt === 'string') &&
      'isBookable' in value &&
      typeof value.isBookable === 'boolean' &&
      'salesStatus' in value &&
      ['coming_soon', 'open', 'sold_out', 'closed'].includes(String(value.salesStatus));

    const readSessions = (card: HTMLElement): CardSession[] => {
      try {
        const value: unknown = JSON.parse(card.dataset.sessions ?? '[]');
        if (!Array.isArray(value) || !value.every(isCardSession)) {
          throw new Error('Sesi event harus berupa array dengan format yang valid.');
        }
        return value;
      } catch (error) {
        console.error('[events] Gagal membaca data sesi kartu event.', error);
        return [];
      }
    };

    const formatSessionDate = (startsAt: string) => {
      const date = new Date(startsAt);
      const day = new Intl.DateTimeFormat(intlLocale, {
        timeZone: 'Asia/Jakarta',
        weekday: 'short',
        day: 'numeric',
        month: 'short',
      }).format(date);
      const time = new Intl.DateTimeFormat(intlLocale, {
        timeZone: 'Asia/Jakarta',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      }).format(date).replace('.', ':');
      return `${day} · ${time} WIB`;
    };

    const formatDuration = (minutes: number) => {
      const { hours, minutes: remainingMinutes } = getDurationParts(minutes);
      return [
        hours > 0 ? t(hours === 1 ? 'oneHour' : 'hours', { count: hours }) : '',
        remainingMinutes > 0
          ? t(remainingMinutes === 1 ? 'oneMinute' : 'minutes', {
              count: remainingMinutes,
            })
          : '',
      ].filter(Boolean).join(' ');
    };

    const formatIDR = (price: number) =>
      new Intl.NumberFormat(intlLocale, {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0,
      }).format(price);

    const formatSalesStatus = (session: CardSession) => {
      if (session.salesStatus === 'coming_soon') {
        return session.registrationOpensAt
          ? `${t('opens')} ${formatSessionDate(session.registrationOpensAt).split(' · ')[0]}`
          : t('openingSoon');
      }
      if (session.salesStatus === 'sold_out') return t('soldOut');
      if (session.salesStatus === 'closed') return t('registrationClosed');
      return t(
        locale === 'en' && session.seatsLeft !== 1 ? 'spotsLeft' : 'oneSpotLeft',
        { seats: session.seatsLeft },
      );
    };

    const renderCard = (card: HTMLElement) => {
      const sessions = readSessions(card);
      const studio = card.querySelector<HTMLElement>('[data-featured-studio]');
      const date = card.querySelector<HTMLElement>('[data-featured-date]');
      const seats = card.querySelector<HTMLElement>('[data-featured-seats]');
      const price = card.querySelector<HTMLElement>('[data-featured-price]');

      if (sessions.length === 0) {
        if (selectedStudio !== 'all') return false;
        if (studio) studio.textContent = t('scheduleSoon');
        if (date) date.textContent = t('dateSoon');
        if (seats) seats.textContent = t('scheduleSoon');
        if (price) price.textContent = t('priceSoon');
        return true;
      }

      const filteredSessions = sessions.filter(
        (session) => selectedStudio === 'all' || session.studioSlug === selectedStudio,
      );
      if (filteredSessions.length === 0) return false;

      const closestSession =
        filteredSessions.find((session) => session.isBookable && session.seatsLeft > 0) ??
        filteredSessions.find((session) => session.salesStatus === 'coming_soon') ??
        filteredSessions[0];
      if (!closestSession) {
        return false;
      }

      const button = card.querySelector<HTMLButtonElement>('[data-book]');
      if (studio) {
        studio.textContent =
          `${closestSession.studioName} · ${formatDuration(closestSession.durationMinutes)}`;
      }
      if (date) date.textContent = formatSessionDate(closestSession.startsAt);
      if (seats) seats.textContent = formatSalesStatus(closestSession);
      if (price) price.textContent = formatIDR(closestSession.price);
      if (button) {
        const soldOut = closestSession.salesStatus === 'sold_out' || closestSession.seatsLeft <= 0;
        const isBookable = closestSession.isBookable && !soldOut;
        button.dataset.sessionId = closestSession.sessionId;
        button.dataset.studioSlug = closestSession.studioSlug;
        button.dataset.price = String(closestSession.price);
        button.dataset.seats = String(closestSession.seatsLeft);
        button.dataset.bookable = String(isBookable);
        button.disabled = !isBookable;
        button.textContent = isBookable
          ? t('bookNow')
          : soldOut
            ? t('soldOut')
            : closestSession.salesStatus === 'coming_soon'
              ? t('openingSoon')
              : t('registrationClosed');
      }
      return true;
    };

    const filterCards = () => {
      const matchingCards = [...cards].filter((card) => {
        const matchesFilter =
          !unavailableEventSlugs.has(card.dataset.eventSlug ?? '') && renderCard(card);
        return matchesFilter;
      });
      const pageCount = Math.max(1, Math.ceil(matchingCards.length / pageSize));
      currentPage = Math.min(currentPage, pageCount);
      const start = (currentPage - 1) * pageSize;
      const visibleCards = new Set(matchingCards.slice(start, start + pageSize));

      cards.forEach((card) => {
        card.hidden = !visibleCards.has(card);
      });

      if (pagination && previousButton && nextButton && pageLabel) {
        pagination.hidden = matchingCards.length <= pageSize;
        previousButton.disabled = currentPage <= 1;
        nextButton.disabled = currentPage >= pageCount;
        pageLabel.textContent = t('pageLabel', {
          current: currentPage,
          total: pageCount,
        });
      }

      if (empty) {
        empty.hidden = matchingCards.length > 0;
        if (matchingCards.length === 0 && selectedStudio !== 'all') {
          empty.textContent = t('filteredEmpty');
        } else if (matchingCards.length === 0) {
          empty.textContent = t('noEvents');
        }
      }
    };

    previousButton?.addEventListener('click', () => {
      if (currentPage <= 1) return;
      currentPage--;
      filterCards();
    });
    nextButton?.addEventListener('click', () => {
      currentPage++;
      filterCards();
    });

    document.addEventListener('booking-events-updated', (event) => {
      if (!(event instanceof CustomEvent) || !Array.isArray(event.detail)) {
        console.error('[events] Respons pembaruan event booking tidak valid.');
        return;
      }
      const sessionsBySlug = new Map<string, { title: string; sessions: CardSession[] }>();
      for (const item of event.detail) {
        if (
          typeof item !== 'object' ||
          item === null ||
          !('slug' in item) ||
          typeof item.slug !== 'string' ||
          !('title' in item) ||
          typeof item.title !== 'string' ||
          !('sessions' in item) ||
          !Array.isArray(item.sessions) ||
          !item.sessions.every(isCardSession)
        ) {
          console.error('[events] Data pembaruan event booking tidak sesuai format.');
          return;
        }
        sessionsBySlug.set(item.slug, { title: item.title, sessions: item.sessions });
      }

      cards.forEach((card) => {
        const slug = card.dataset.eventSlug ?? '';
        const eventData = sessionsBySlug.get(slug);
        if (!eventData) {
          unavailableEventSlugs.add(slug);
          return;
        }
        unavailableEventSlugs.delete(slug);
        card.dataset.sessions = JSON.stringify(eventData.sessions);
        card.dataset.eventTitle = eventData.title;
        const title = card.querySelector<HTMLAnchorElement>('h3 a');
        if (title) title.textContent = eventData.title;
      });
      filterCards();
    });

    studioButtons.forEach((button) =>
      button.addEventListener('click', () => {
        selectedStudio = button.dataset.studioFilter ?? 'all';
        currentPage = 1;
        studioButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        filterCards();
      }),
    );

    filterCards();
  });
</script>