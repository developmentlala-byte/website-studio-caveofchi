---
import BookButton from '@/components/booking/BookButton.astro';
import type { CaveEvent } from '@/lib/events';
import { getCategoryLabel } from '@/lib/site';
import { createT, localizedPath, toLocale } from '@/i18n';
import { messages } from './EventCard.messages';
import {
  formatDateShort,
  getDurationParts,
  formatIDR,
  formatTime,
} from '@/lib/format';

type EventSession = CaveEvent['data']['sessions'][number];
interface Props { event: CaveEvent; hidden?: boolean }
const { event, hidden = false } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = createT(locale, messages);
const formatDuration = (duration: number) => {
  const { hours, minutes } = getDurationParts(duration);
  return [
    hours > 0 ? t(hours === 1 ? 'oneHour' : 'hours', { count: hours }) : '',
    minutes > 0
      ? t(minutes === 1 ? 'oneMinute' : 'minutes', { count: minutes })
      : '',
  ].filter(Boolean).join(' ');
};
const d = event.data;
const sessions: EventSession[] = d.sessions
  .filter((session) => session.startsAt.getTime() >= Date.now())
  .sort((a, b) => a.startsAt.getTime() - b.startsAt.getTime());
const featuredSession =
  sessions.find((session) => session.isBookable && session.seatsLeft > 0) ??
  sessions.find((session) => session.salesStatus === 'coming_soon') ??
  sessions[0];
const sessionOptions = sessions.map((session) => ({
  sessionId: session.sessionId,
  startsAt: session.startsAt.toISOString(),
  durationMinutes: session.durationMinutes,
  price: session.price,
  seatsLeft: session.seatsLeft,
  studioSlug: session.space,
  studioName: session.studioName,
  registrationOpensAt: session.registrationOpensAt?.toISOString() ?? null,
  isBookable: session.isBookable,
  salesStatus: session.salesStatus,
}));
const seatsLeft = (seats: number) =>
  locale === 'en'
    ? t(seats === 1 ? 'oneSpotLeft' : 'spotsLeft', { seats })
    : t('spotsLeft', { seats });

// Harga antar sesi dapat berbeda; tampilkan harga terendah untuk rentang harga.
const prices = sessions.map((session) => session.price);
const hasPriceRange = new Set(prices).size > 1;
const displayPrice = hasPriceRange
  ? Math.min(...prices)
  : featuredSession?.price;
const priceLabel = sessions.length === 0
  ? t('price')
  : hasPriceRange
    ? t('startingAt')
    : t('perGuest');
const featuredStatus = featuredSession?.salesStatus === 'coming_soon'
  ? `${t('salesOpen')} ${featuredSession.registrationOpensAt
      ? formatDateShort(featuredSession.registrationOpensAt, locale)
      : t('soon')}`
  : featuredSession?.salesStatus === 'sold_out'
    ? t('soldOut')
    : featuredSession?.salesStatus === 'closed'
      ? t('registrationClosed')
      : featuredSession
        ? seatsLeft(featuredSession.seatsLeft)
        : t('scheduleSoon');
---
<article
  class="event-card"
  hidden={hidden}
  data-event-card
  data-event-slug={event.id}
  data-event-title={d.title}
  data-sessions={JSON.stringify(sessionOptions)}
  data-category={d.category ?? 'uncategorized'}
>
  <div class="event-image">
    {d.imageUrl && <img src={d.imageUrl} alt="" width="640" height="474" loading="lazy" />}
    <span class="event-category">{getCategoryLabel(d.category)}</span>
  </div>
  <div class="event-info">
    <div class="event-sub" data-featured-studio>
      {featuredSession
        ? `${featuredSession.studioName} · ${formatDuration(featuredSession.durationMinutes)}`
        : t('scheduleSoon')}
    </div>
    <h3><a href={localizedPath(locale, `/experiences/${event.id}`)}>{d.title}</a></h3>
    <div class="event-details">
      <span data-featured-date>
        {featuredSession
          ? `${formatDateShort(featuredSession.startsAt, locale)} · ${formatTime(featuredSession.startsAt, locale)} WIB`
          : t('dateSoon')}
      </span>
      <span data-featured-seats>{featuredStatus}</span>
    </div>
    <div class="event-footer">
      <div class="event-price">
        <small>{priceLabel}</small>
        <span data-featured-price>
          {displayPrice !== undefined
            ? formatIDR(displayPrice, locale)
            : sessions.length === 0
              ? t('announcedSoon')
              : '–'}
        </span>
      </div>
      {featuredSession ? (
        <BookButton event={event} session={featuredSession}>
          {featuredSession.isBookable
            ? t('bookNow')
            : featuredSession.salesStatus === 'coming_soon'
              ? t('openingSoon')
              : featuredSession.salesStatus === 'sold_out'
                ? t('soldOut')
                : t('registrationClosed')}
        </BookButton>
      ) : (
        <a class="book details-link" href={localizedPath(locale, `/experiences/${event.id}`)}>{t('viewDetails')} ↗</a>
      )}
    </div>
  </div>
</article>

<style>
  /* Nilai mengikuti card referensi (index.html) */
  .event-card {
    position: relative;
    border: 1px solid #ece4da;
    background: #f7f2ea;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }

  .event-card:hover {
    box-shadow: 0 20px 45px #604a301c;
    transform: translateY(-3px);
  }

  .event-card[hidden] {
    display: none;
  }

  .event-image {
    position: relative;
    aspect-ratio: 1.35;
    overflow: hidden;
    background: #ddc2a6;
  }

  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .event-card:hover .event-image img {
    transform: scale(1.05);
  }

  .event-category {
    position: absolute;
    top: 15px;
    left: 15px;
    padding: 9px 12px;
    border-radius: 2px;
    background: #f9f3e9eb;
    backdrop-filter: blur(8px);
    color: #493d31;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .event-info {
    padding: 23px 22px 21px;
  }

  .event-sub {
    color: #9b806b;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-info h3 {
    margin: 8px 0 17px;
    color: var(--umber);
    font-family: var(--font-heading);
    font-size: 37px;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .event-info h3 a {
    color: inherit;
  }

  .event-details {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 13px 0;
    border-top: 1px solid #ded4c8;
    color: #70645b;
    font-size: 11px;
  }

  .event-details span:last-child {
    text-align: right;
  }

  .event-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 15px;
  }

  .event-price {
    color: var(--umber);
    font-family: var(--font-heading);
    font-size: 29px;
    font-weight: 600;
    line-height: 1.1;
  }

  .event-price small {
    display: block;
    margin-bottom: 3px;
    color: #807267;
    font: 9px var(--font-body);
  }

  /* Tombol dirender BookButton, jadi distyle lewat :global */
  .event-footer :global(.book),
  .event-footer :global(button) {
    padding: 12px 17px;
    border: none;
    border-radius: 0;
    background: var(--umber);
    color: #fff;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: normal;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .event-footer :global(.book:hover),
  .event-footer :global(button:hover:not(:disabled)),
  .event-footer .details-link:hover {
    background: #8a644e;
  }

  .event-footer :global(.book:disabled),
  .event-footer :global(button:disabled),
  .event-footer :global(button[disabled]) {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .details-link {
    text-decoration: none;
  }

  @media (max-width: 740px) {
    .event-image {
      aspect-ratio: 1.55;
    }
  }

  @media (max-width: 380px) {
    .event-footer {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-card,
    .event-image img {
      transition: none;
    }

    .event-card:hover {
      transform: none;
    }

    .event-card:hover .event-image img {
      transform: none;
    }
  }
</style>