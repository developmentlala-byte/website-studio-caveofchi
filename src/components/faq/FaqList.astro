---
import { createT, toLocale } from "@/i18n";
import { messages } from "./FaqList.messages";
const t = createT(toLocale(Astro.currentLocale), messages);

const items = [
  { question: "openingQuestion", answer: "openingAnswer" },
  { question: "beginnersQuestion", answer: "beginnersAnswer" },
  { question: "pricesQuestion", answer: "pricesAnswer" },
  { question: "capacityQuestion", answer: "capacityAnswer" },
  { question: "privateQuestion", answer: "privateAnswer" },
  { question: "bookingQuestion", answer: "bookingAnswer" },
] as const;

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: t(item.question),
    acceptedAnswer: { "@type": "Answer", text: t(item.answer) },
  })),
}).replaceAll("<", "\\u003c");
---
<div class="faq-list">
  {items.map((item, index) => (
    <details open={index === 0}>
      <summary>{t(item.question)}</summary>
      <p>{t(item.answer)}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={faqJsonLd} />

<style>
  .faq-list {
    max-width: 850px;
    margin: 0 auto var(--space-6);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    position: relative;
    padding: 21px 38px 21px 0;
    color: var(--umber);
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 24px;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    position: absolute;
    right: 4px;
    content: "+";
    font-family: var(--font-body);
    font-size: 20px;
  }

  details[open] summary::after {
    content: "−";
  }

  details p {
    max-width: 700px;
    margin: 0;
    padding: 0 32px 22px 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
  }
</style>