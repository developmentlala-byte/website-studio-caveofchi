---
const FAQS = [
  {
    q: 'Apakah pemula boleh ikut kelas?',
    a: 'Tentu. Mayoritas workshop dirancang ramah pemula. Fasilitator akan membimbing langkah demi langkah.',
  },
  {
    q: 'Apa yang sudah termasuk di harga kelas?',
    a: 'Harga sudah mencakup material, pendampingan fasilitator, dan minuman hangat selama sesi. Detail tiap kelas bisa dilihat di halaman experiences.',
  },
  {
    q: 'Bolehkah membuat private class?',
    a: 'Bisa. Untuk kelompok kecil, ulang tahun, atau acara tim, kamu bisa request private class dan kami akan membantu mengatur jadwalnya.',
  },
  {
    q: 'Apakah pembayaran bisa dilakukan di website?',
    a: 'Untuk versi demo ini, pembayaran belum aktif. Nantinya kamu bisa reserve dan membayar langsung lewat website.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<section class="faq section" id="faq">
  <div class="container faq-inner">
    <div class="faq-head">
      <div class="eyebrow">Before your first visit</div>
      <h2 class="heading">A few<br /><em class="script-cstt-color">good things</em><br />to know.</h2>
    </div>
    <div class="faq-list">
      {FAQS.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>

  .script-cstt-color {
font-family: "Cormorant Garamond", Georgia, serif;
font-size: 76px;
font-weight: 500;
font-style: italic;
line-height: 74px;
letter-spacing: -4.18px;
color: #2e2924;
  }

  .faq {
    background: #ede4d9;
  }

  .faq-inner {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 12%;
    align-items: start;
  }

  .faq-head .eyebrow {
    margin-bottom: 0;
  }

  .faq-head .heading {
    margin: 12px 0;
    font-size: 76px;
  }

  .faq-list {
    border-top: 0;
  }

  details {
    padding: 20px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--umber) 22%, transparent);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-size: 27px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    color: #2e2924;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--umber);
    outline-offset: 4px;
  }

  .faq-icon {
    flex: 0 0 auto;
    color: #8f7260;
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: var(--fw-ui);
    line-height: 1;
  }

  .faq-icon::before {
    content: "+";
  }

  details[open] .faq-icon::before {
    content: "–";
  }

  details p {
    max-width: 540px;
    margin: 12px 0;
    color: #78695e;
    font-size: 12px;
    line-height: 1.9;
  }

  @media (max-width: 740px) {
    .faq-inner {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    summary {
      padding: 22px 0;
      font-size: 24px;
    }

    .faq-head .heading {
      font-size: 70px;
    }
  }
</style>