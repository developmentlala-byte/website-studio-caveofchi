---
import type { PublicStudio } from '@/lib/api/studios';

interface Props { studios: PublicStudio[] }
const { studios } = Astro.props;

/** Jeda antar slide (ms). */
const AUTOPLAY_MS = 6000;
/** Durasi crossfade (ms). */
const FADE_MS = 1200;
/** Batasi jumlah slide supaya hero tetap ringan. */
const MAX_SLIDES = 6;

const slides = studios
  .filter(
    (studio): studio is PublicStudio & { coverImageUrl: string } =>
      studio.coverImageUrl !== null,
  )
  .slice(0, MAX_SLIDES);

const total = slides.length;
const multiple = total > 1;
const studioNames = studios.map((studio) => studio.name).join(' • ');
const initialLabel = multiple ? slides[0].name : studioNames;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section
  class="hero"
  aria-label="Selamat datang di Cave of Chi"
  data-hero
  data-fade={FADE_MS}
  style={`--hero-delay:${AUTOPLAY_MS}ms;--hero-fade:${FADE_MS}ms`}
>
  <div class="hero-media">
    <div class="hero-primary" data-stack>
      {slides.map((studio, i) => (
        <div class:list={['slide', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'}>
          <img
            src={i === 0 ? studio.coverImageUrl : undefined}
            data-src={i === 0 ? undefined : studio.coverImageUrl}
            alt={`Interior ${studio.name}`}
            width="1280"
            height="800"
            decoding="async"
            draggable="false"
            loading={i === 0 ? 'eager' : undefined}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </div>
      ))}
    </div>
  </div>

  <div class="hero-content">
    <div class="hero-copy">
      <div class="eyebrow hero-kicker">A creative social sanctuary</div>
      <h1>Cave<br /><em>of Chi.</em></h1>
      <p>A space to make, to feel, and to belong. Temukan workshop dan ritual yang cocok, lalu pilih jadwal dan pesan tempat langsung di website.</p>
      <a class="cta-light" href="/experiences" data-book>Lihat jadwal &amp; pesan <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-aside-label" aria-hidden="true">The art of being present</div>
    <div class="hero-bottom" aria-hidden="true">
      <span class="scroll-indicator">Scroll to discover</span>
      {initialLabel && <span data-label>{initialLabel}</span>}
    </div>

    {multiple && (
      <div class="hero-controls" role="group" aria-label="Kontrol galeri studio">
        <button type="button" class="hc-toggle" data-toggle aria-label="Jeda pergantian otomatis">
          <svg class="icon-pause" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
            <path d="M3 2h2.5v10H3zM8.5 2H11v10H8.5z" />
          </svg>
          <svg class="icon-play" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
            <path d="M4 2.5v9l7.5-4.5z" />
          </svg>
        </button>
        <ol class="hc-dots">
          {slides.map((studio, i) => (
            <li>
              <button
                type="button"
                class="hc-dot"
                data-dot={i}
                data-name={studio.name}
                aria-label={`Tampilkan ${studio.name}`}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <span class="hc-fill"></span>
              </button>
            </li>
          ))}
        </ol>
        <span class="hc-count" aria-hidden="true"><span data-count>01</span> / {pad(total)}</span>
        <p class="sr-only" aria-live="polite" data-live></p>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(700px, min(780px, 88svh));
    overflow: hidden;
    background: #5e4836;
    color: #fff;
    touch-action: pan-y;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-primary {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* Overlay selalu di atas semua slide: gelap di kiri (teks) dan sedikit di atas/bawah */
  .hero-primary::after {
    position: absolute;
    z-index: 3;
    inset: 0;
    background:
      linear-gradient(90deg, var(--umber-overlay-strong), var(--umber-overlay-medium) 45%, transparent 90%),
      linear-gradient(180deg, var(--umber-overlay-soft), transparent 25%, transparent 70%, var(--umber-overlay-soft));
    content: "";
    pointer-events: none;
  }

  /* ---------- Carousel (crossfade) ----------
     Slide masuk fade-in DI ATAS slide keluar yang tetap opacity 1,
     jadi tidak ada "kedip" warna dasar di tengah transisi. */
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }

  .slide.is-leaving {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    will-change: opacity;
  }

  .slide.is-active {
    z-index: 2;
    opacity: 1;
    visibility: visible;
    transition: opacity var(--hero-fade) ease-in-out;
    will-change: opacity;
  }

  .slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* Zoom halus (hanya transform, jalan di compositor). Mulai dari scale(1)
     supaya tidak ada lompatan saat JS aktif. */
  @media (prefers-reduced-motion: no-preference) {
    .hero[data-ready] .slide.is-active img,
    .hero[data-ready] .slide.is-leaving img {
      animation: hero-zoom calc(var(--hero-delay) + var(--hero-fade)) ease-out forwards;
      will-change: transform;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide.is-active {
      transition-duration: 200ms;
    }
  }

  @keyframes hero-zoom {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }

  @keyframes hero-progress {
    to { transform: scaleX(1); }
  }

  /* Saat dijeda (hover kontrol, tab tidak aktif, hero di luar layar, atau tombol jeda) */
  .hero.is-halted .slide img,
  .hero.is-halted .hc-fill {
    animation-play-state: paused;
  }

  /* Lapisan konten selebar hero (tanpa container) */
  .hero-content {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ---------- Blok teks utama ---------- */
  .hero-copy {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: clamp(24px, 6.5vw, 160px);
    width: min(560px, 58vw);
    transform: translateY(-43%);
    pointer-events: auto;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 13px;
    color: #eee3d6;
  }

  .hero-kicker::before {
    width: 33px;
    height: 1px;
    background: currentColor;
    opacity: 0.75;
    content: "";
  }

  /* 154px / 120px / -8.47px di layar lebar, mengecil proporsional di layar kecil */
  .hero-copy h1 {
    margin: 35px 0 30px;
    font-family: var(--font-heading);
    color: #fff;
    font-size: clamp(84px, 9vw, 154px);
    font-weight: 500;
    line-height: 0.78;
    letter-spacing: -0.055em;
  }

  /* "of Chi." italic dan menjorok ke kanan */
  .hero-copy h1 em {
    display: block;
    margin-left: 75px;
    color: inherit;
    font-style: italic;
    font-weight: 400;
  }

  .hero-copy p {
    max-width: 380px;
    margin: 0 0 36px 6px;
    color: #efe4db;
    font-size: 13px;
    line-height: 1.95;
  }

  .cta-light {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    padding: 15px 20px;
    border: 0;
    border-radius: 0;
    background: #f3e9dd;
    color: #44352a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: normal;
    text-transform: uppercase;
    transition: background 200ms ease;
  }

  .cta-light:hover {
    background: #dac3a8;
  }

  .cta-light span {
    font-size: 19px;
    font-weight: 400;
    line-height: 1;
  }

  /* ---------- Label vertikal & bar bawah ---------- */
  .hero-aside-label {
    position: absolute;
    z-index: 4;
    right: 25px;
    bottom: 35px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 10px;
    letter-spacing: 0.26em;
    line-height: normal;
    text-transform: uppercase;
  }

  .hero-bottom {
    position: absolute;
    z-index: 4;
    right: 0;
    bottom: 23px;
    left: 0;
    display: flex;
    justify-content: space-between;
    color: #e6d7c7;
    padding: 0 max(4.3vw, 24px);
    font-size: 9px;
    letter-spacing: 0.17em;
    line-height: normal;
    text-transform: uppercase;
  }

  .scroll-indicator {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }

  .scroll-indicator::before {
    width: 38px;
    height: 1px;
    background: currentColor;
    content: "";
  }

  /* ---------- Kontrol carousel ---------- */
  .hero-controls {
    position: absolute;
    z-index: 4;
    bottom: 58px;
    left: clamp(24px, 6.5vw, 160px);
    display: flex;
    align-items: center;
    gap: 18px;
    color: #eee3d6;
    pointer-events: auto;
    /* disembunyikan sampai JS siap, supaya tidak ada tombol "mati" */
    visibility: hidden;
  }

  .hero[data-ready] .hero-controls {
    visibility: visible;
  }

  .hc-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid rgb(238 227 214 / 0.5);
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease;
  }

  .hc-toggle:hover {
    background: #f3e9dd;
    color: #44352a;
  }

  .hc-toggle svg {
    width: 12px;
    height: 12px;
    fill: currentColor;
  }

  .hc-toggle .icon-play {
    display: none;
  }

  .hero[data-autoplay="false"] .hc-toggle .icon-play {
    display: block;
  }

  .hero[data-autoplay="false"] .hc-toggle .icon-pause {
    display: none;
  }

  .hc-dots {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Area klik 40x24 walau garis visualnya hanya 2px */
  .hc-dot {
    position: relative;
    display: block;
    width: 40px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .hc-dot::before,
  .hc-fill {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 2px;
    margin-top: -1px;
    content: "";
  }

  .hc-dot::before {
    background: rgb(255 255 255 / 0.32);
    transition: background 200ms ease;
  }

  .hc-dot:hover::before {
    background: rgb(255 255 255 / 0.6);
  }

  .hc-fill {
    background: #fff;
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* Progress = timer autoplay. animationend memicu pindah slide, jadi
     jeda/lanjut otomatis akurat (sisa waktu tidak hilang). */
  .hero[data-ready][data-autoplay="true"] .hc-dot[aria-current="true"] .hc-fill {
    animation: hero-progress var(--hero-delay) linear forwards;
  }

  .hero[data-ready][data-autoplay="false"] .hc-dot[aria-current="true"] .hc-fill {
    transform: scaleX(1);
  }

  .hc-count {
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.17em;
  }

  .hc-toggle:focus-visible,
  .hc-dot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 740px) {
    .hero {
      min-height: min(760px, max(680px, 90svh));
    }

    .hero-aside-label {
      display: none;
    }

    .hero-primary::after {
      background: linear-gradient(90deg, var(--umber-overlay-strong), var(--umber-overlay-subtle));
    }

    .hero-copy {
      top: 45%;
      left: 24px;
      width: calc(100% - 48px);
      transform: translateY(-30%);
    }

    .hero-copy h1 {
      margin: 22px 0 24px;
      font-size: clamp(86px, 22vw, 124px);
    }

    .hero-copy p {
      max-width: 320px;
      font-size: 13px;
      line-height: 1.8;
    }

    .cta-light {
      margin-top: 28px;
    }

    .hero-bottom {
      right: 20px;
      bottom: 18px;
      left: 20px;
      padding: 0 25px;
      font-size: 8px;
    }

    .hero-controls {
      bottom: 50px;
      left: 24px;
      gap: 14px;
    }

    .hc-dot {
      width: 30px;
    }
  }
</style>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');
  const idle = (fn: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(fn) : setTimeout(fn, 200);

  function setup(root: HTMLElement) {
    if (root.dataset.ready) return;

    const stacks = Array.from(root.querySelectorAll<HTMLElement>('[data-stack]'));
    const layers = stacks.map((s) => Array.from(s.querySelectorAll<HTMLElement>('.slide')));
    const total = layers[0]?.length ?? 0;
    if (total < 2) return; // 0 atau 1 gambar: tetap statis, tanpa JS tambahan

    root.dataset.ready = 'true';

    const fadeMs = Number(root.dataset.fade) || 1200;
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const controls = root.querySelector<HTMLElement>('.hero-controls');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const label = root.querySelector<HTMLElement>('[data-label]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const live = root.querySelector<HTMLElement>('[data-live]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    let current = 0;
    let autoplay = !reduced.matches; // pengguna reduced-motion: tidak autoplay
    let hovered = false;
    let inView = true;
    let locked = false;
    const failed = new Set<number>();

    const visible = (el: HTMLElement) => el.getClientRects().length > 0;

    function sync() {
      const halted = !autoplay || hovered || !inView || document.hidden;
      root.dataset.autoplay = String(autoplay);
      root.classList.toggle('is-halted', halted);
      toggle?.setAttribute(
        'aria-label',
        autoplay ? 'Jeda pergantian otomatis' : 'Putar pergantian otomatis',
      );
    }

    /** Set src (jika belum) lalu decode, sehingga saat fade gambar sudah siap. */
    async function load(index: number): Promise<boolean> {
      let ok = true;
      await Promise.all(
        stacks.map(async (stack, s) => {
          if (!visible(stack)) return;
          const img = layers[s][index]?.querySelector('img');
          if (!img) return;
          if (img.dataset.src) {
            img.src = img.dataset.src;
            delete img.dataset.src;
          }
          try {
            await img.decode();
          } catch {
            if (s === 0) ok = false;
          }
        }),
      );
      return ok;
    }

    async function goTo(target: number, opts: { user?: boolean; step?: number } = {}) {
      const { user = false, step = 1 } = opts;
      target = (target + total) % total;
      if (target === current || locked) return;
      locked = true;

      if (!(await load(target))) {
        // gambar gagal dimuat: lewati ke slide berikutnya
        failed.add(target);
        locked = false;
        if (failed.size < total - 1) goTo(target + step, opts);
        return;
      }

      const prev = current;
      current = target;

      stacks.forEach((_, s) => {
        const out = layers[s][prev];
        const inn = layers[s][target];
        out.classList.replace('is-active', 'is-leaving');
        out.setAttribute('aria-hidden', 'true');
        inn.classList.add('is-active');
        inn.removeAttribute('aria-hidden');
      });

      dots.forEach((d, i) =>
        i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current'),
      );
      const name = dots[current]?.dataset.name ?? '';
      if (label) label.textContent = name;
      if (count) count.textContent = pad(current + 1);
      // Diumumkan ke screen reader hanya untuk navigasi manual, bukan autoplay
      if (user && live) live.textContent = `${name}, ${current + 1} dari ${total}`;

      setTimeout(() => {
        layers.forEach((stack) => stack.forEach((l) => l.classList.remove('is-leaving')));
        locked = false;
      }, fadeMs);

      load((current + 1) % total); // siapkan slide berikutnya
    }

    // Timer autoplay = animasi progress CSS; selesai => slide berikutnya
    root.addEventListener('animationend', (e) => {
      if ((e.target as Element).classList.contains('hc-fill') && autoplay) goTo(current + 1);
    });

    root.addEventListener('click', (e) => {
      const el = e.target as Element;
      const dot = el.closest<HTMLElement>('[data-dot]');
      if (dot) {
        goTo(Number(dot.dataset.dot), { user: true });
        return;
      }
      if (el.closest('[data-toggle]')) {
        autoplay = !autoplay;
        sync();
        if (live) live.textContent = autoplay ? 'Pergantian otomatis aktif' : 'Pergantian otomatis dijeda';
      }
    });

    // Swipe di layar sentuh
    let x0 = 0;
    let y0 = 0;
    root.addEventListener('touchstart', (e) => {
      x0 = e.touches[0].clientX;
      y0 = e.touches[0].clientY;
    }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const t = e.changedTouches[0];
      const dx = t.clientX - x0;
      const dy = t.clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        const step = dx < 0 ? 1 : -1;
        goTo(current + step, { user: true, step });
      }
    }, { passive: true });

    // Jeda hanya saat kursor di atas kontrol (bukan seluruh hero, agar autoplay tetap jalan)
    if (matchMedia('(hover: hover)').matches && controls) {
      controls.addEventListener('mouseenter', () => { hovered = true; sync(); });
      controls.addEventListener('mouseleave', () => { hovered = false; sync(); });
    }

    // Jeda saat hero keluar layar atau tab tidak aktif (hemat CPU/baterai)
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      sync();
    }, { threshold: 0.2 }).observe(root);

    const onVisibility = () => {
      if (!root.isConnected) {
        document.removeEventListener('visibilitychange', onVisibility);
        return;
      }
      sync();
    };
    document.addEventListener('visibilitychange', onVisibility);

    reduced.addEventListener('change', (e) => { autoplay = !e.matches; sync(); });

    sync();

    // Pemanasan: muat slide ke-2 setelah halaman selesai dan browser idle,
    // jadi tidak bersaing bandwidth dengan LCP.
    const warm = () => idle(() => { load(1 % total); });
    if (document.readyState === 'complete') warm();
    else addEventListener('load', warm, { once: true });
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-hero]').forEach(setup);
  }

  init();
  document.addEventListener('astro:page-load', init); // kompatibel dengan View Transitions
</script>