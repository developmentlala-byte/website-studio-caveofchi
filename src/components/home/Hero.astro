---
import type { PublicStudio } from '@/lib/api/studios';

interface Props { studios: PublicStudio[] }
const { studios } = Astro.props;
const studiosWithImages = studios.filter(
  (studio): studio is PublicStudio & { coverImageUrl: string } =>
    studio.coverImageUrl !== null,
);
const primaryStudio = studiosWithImages[0];
const asideStudio = studiosWithImages[1] ?? primaryStudio;
const studioNames = studios.map((studio) => studio.name).join(' • ');
---
<section class="hero" aria-label="Selamat datang di Cave of Chi">
  <div class="hero-media">
    <div class="hero-primary">
      {primaryStudio && <img src={primaryStudio.coverImageUrl} alt={`Interior ${primaryStudio.name}`}
        width="1280" height="800" loading="eager" fetchpriority="high" />}
    </div>
    <div class="hero-aside">
      {asideStudio && <img src={asideStudio.coverImageUrl} alt={`Interior ${asideStudio.name}`}
        width="720" height="800" loading="eager" />}
    </div>
  </div>
  <div class="hero-content">
    <div class="hero-copy">
      <div class="eyebrow hero-kicker">A creative social sanctuary</div>
      <h1>Cave<br /><em>of Chi.</em></h1>
      <p>A space to make, to feel, and to belong. Temukan jeda dari rutinitas, lewat karya, ritual, dan koneksi yang bermakna.</p>
      <a class="cta-light" href="/experiences" data-book>Explore our experiences <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-aside-label" aria-hidden="true">The art of being present</div>
    <div class="hero-bottom" aria-hidden="true">
      <span class="scroll-indicator">Scroll to discover</span>
      {studioNames && <span>{studioNames}</span>}
    </div>
  </div>
</section>
<style>
  .hero {
    position: relative;
    min-height: max(700px, min(780px, 88svh));
    overflow: hidden;
    background: #5e4836;
    color: #fff;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1.7fr 1fr;
  }

  .hero-primary,
  .hero-aside {
    position: relative;
    overflow: hidden;
  }

  .hero-primary::after,
  .hero-aside::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--umber-overlay-medium), transparent 88%);
    content: "";
  }

  .hero-aside::after {
    background: linear-gradient(
      180deg,
      var(--umber-overlay-strong),
      var(--umber-overlay-subtle) 48%,
      var(--umber-overlay-soft)
    );
  }

  .hero-primary :global(img),
  .hero-aside :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Lapisan konten selebar hero (tanpa container) */
  .hero-content {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ---------- Blok teks utama ---------- */
  .hero-copy {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: clamp(24px, 6.5vw, 160px);
    width: min(560px, 58vw);
    transform: translateY(-43%);
    pointer-events: auto;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 13px;
    color: #eee3d6;
  }

  .hero-kicker::before {
    width: 33px;
    height: 1px;
    background: currentColor;
    opacity: 0.75;
    content: "";
  }

  /* 154px / 120px / -8.47px di layar lebar, mengecil proporsional di layar kecil */
  .hero-copy h1 {
    margin: 35px 0 30px;
    font-family: var(--font-heading);
    color: #fff;
    font-size: clamp(84px, 9vw, 154px);
    font-weight: 500;
    line-height: 0.78;
    letter-spacing: -0.055em;
  }

  /* "of Chi." italic dan menjorok ke kanan */
  .hero-copy h1 em {
    display: block;
    margin-left: 75px;
    color: inherit;
    font-style: italic;
    font-weight: 400;
  }

  .hero-copy p {
    max-width: 380px;
    margin: 0 0 36px 6px;
    color: #efe4db;
    font-size: 13px;
    line-height: 1.95;
  }

  .cta-light {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    padding: 15px 20px;
    border: 0;
    border-radius: 0;
    background: #f3e9dd;
    color: #44352a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: normal;
    text-transform: uppercase;
    transition: background 200ms ease;
  }

  .cta-light:hover {
    background: #dac3a8;
  }

  .cta-light span {
    font-size: 19px;
    font-weight: 400;
    line-height: 1;
  }

  /* ---------- Label vertikal & bar bawah ---------- */
  .hero-aside-label {
    position: absolute;
    z-index: 2;
    right: 25px;
    bottom: 35px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 10px;
    letter-spacing: 0.26em;
    line-height: normal;
    text-transform: uppercase;
  }

  .hero-bottom {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 23px;
    left: 0;
    display: flex;
    justify-content: space-between;
    color: #e6d7c7;
    padding: 0 max(4.3vw, 24px);
    font-size: 9px;
    letter-spacing: 0.17em;
    line-height: normal;
    text-transform: uppercase;
  }

  .scroll-indicator {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }

  .scroll-indicator::before {
    width: 38px;
    height: 1px;
    background: currentColor;
    content: "";
  }

  @media (max-width: 740px) {
    .hero {
      min-height: min(760px, max(680px, 90svh));
    }

    .hero-media {
      grid-template-columns: 1fr;
    }

    .hero-primary {
      min-height: 0;
    }

    .hero-aside {
      display: none;
    }

    .hero-aside-label {
      display: none;
    }

    .hero-copy h1 {
      margin: 29px 0 27px;
      font-size: clamp(81px, 16vw, 128px);
    }

    .hero-copy p {
      max-width: 300px;
      font-size: 12px;
    }

    @media (max-width: 1050px) {
      .hero-copy h1 {
        font-size: clamp(72px, 10vw, 130px);
      }
    }

    .hero-bottom {
      padding: 0 25px;
      font-size: 8px;
    }

    .hero-primary::after {
      background: linear-gradient(90deg, var(--umber-overlay-strong), var(--umber-overlay-subtle));
    }

    .hero-copy {
      top: 45%;
      left: 24px;
      width: calc(100% - 48px);
      transform: translateY(-30%);
    }

    .hero-copy h1 {
      margin: 22px 0 24px;
      font-size: clamp(86px, 22vw, 124px);
    }

    .hero-copy p {
      max-width: 320px;
      font-size: 13px;
      line-height: 1.8;
    }

    .cta-light {
      margin-top: 28px;
    }

    .hero-bottom {
      right: 20px;
      bottom: 18px;
      left: 20px;
      font-size: 8px;
    }
  }
</style>