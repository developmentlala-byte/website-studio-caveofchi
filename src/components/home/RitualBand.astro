---
// RitualBand.astro
import sound from '@/assets/images/sound.webp';
import { RITUAL_STEPS } from '@/data/ritual';
import { translate } from '@/lib/i18n';
const locale = Astro.locals.locale;
---
<section class="ritual">
  <div class="ritual-photo">
    <img src={sound.src} width={sound.width} height={sound.height}
      alt={locale === 'en'
        ? 'A candlelit sound healing session with a singing bowl and gong'
        : 'Suasana sound healing dengan singing bowl dan gong di dalam cave bercahaya lilin'} loading="lazy" />
  </div>
  <div class="ritual-copy">
    <div class="eyebrow">05 / {translate(locale, 'The Cave of Chi way')}</div>
    <h2>
      {locale === 'en'
        ? <>Come as<br />you <em class="script-cstt-color">are.</em></>
        : <>Datanglah<br /><em class="script-cstt-color">apa adanya.</em></>}
    </h2>
    <p>{translate(locale, 'Tidak perlu jadi seniman untuk berkarya. Tidak perlu tahu apa-apa tentang meditasi untuk mulai. Di sini, rasa penasaran sudah cukup untuk memulai.')}</p>
    <div class="ritual-steps">
      {RITUAL_STEPS.map((s) => (<div><strong>{s.title}</strong><small>{translate(locale, s.text)}</small></div>))}
    </div>
  </div>
</section>
<style>
  .script-cstt-color {
      font-style: italic;
  font-weight: 500;
  }
  .ritual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #514137;
    color: var(--paper-light);
  }

  .ritual-photo {
    position: relative;
    min-height: 600px;
    overflow: hidden;
  }

  .ritual-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ritual-copy {
    align-self: center;
    padding: var(--space-5) clamp(32px, 8vw, 120px);
  }

  .ritual-copy h2 {
    margin: 23px 0;
    font-family: var(--font-heading);
    font-size: clamp(58px, 6.5vw, 96px);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.05em;
    color: #fff;
  }

  .ritual .eyebrow {
    color: #d9bba4;
  }

  .ritual-copy > p {
    max-width: 425px;
    margin: 13px 0;
    color: #e0cfc0;
    font-size: 13px;
    line-height: 2;
  }

  .ritual-steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 28px;
    margin-top: var(--space-4);
  }

  .ritual-steps > div {
    display: grid;
    gap: 6px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, var(--paper-light) 22%, transparent);
  }

  .ritual-steps strong {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 500;
    line-height: normal;
    color: #fff;
  }

  .ritual-steps small {
    color: #cbb8a8;
    font-size: 11px;
    line-height: 1.7;
  }

  @media (max-width: 740px) {
    .ritual {
      grid-template-columns: 1fr;
    }

    .ritual-photo {
      min-height: 340px;
    }

    .ritual-copy {
      padding: var(--space-5) 24px;
    }

    .ritual-copy h2 {
      font-size: 71px;
    }
  }
</style>