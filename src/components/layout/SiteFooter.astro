---
import Brand from '@/components/layout/Brand.astro';
import { SITE, NAV_LINKS } from '@/lib/site';
import { localizedPath, translate } from '@/lib/i18n';
const year = new Date().getFullYear();
const locale = Astro.locals.locale;
---
<footer class="footer">
  <div class="container">
    <div class="footer-upper">
      <div>
        <Brand size="lg" />
        <p class="footer-caption">{translate(locale, 'An invitation to slow down, create and connect.')}</p>
      </div>
      <div class="footer-links">
        <div>
          <strong>{translate(locale, 'Discover')}</strong>
          {NAV_LINKS.filter((l) => l.label !== 'Community').map((l) => (
            <a href={localizedPath(locale, l.href)}>
              {l.label === 'Our Story'
                ? translate(locale, 'Our story')
                : l.label === 'The Caves'
                  ? translate(locale, 'The Caves')
                  : translate(locale, l.label)}
            </a>
          ))}
        </div>
        <div>
          <strong>{translate(locale, 'Connect')}</strong>
          <a href={localizedPath(locale, '/about#community')}>{translate(locale, 'Our community')}</a>
          <span>Instagram: {SITE.instagram}</span>
          <span>WhatsApp: {translate(locale, 'coming soon')}</span>
          <!-- <span>{translate(locale, 'Location')}:</span> -->
          <a
            href="https://www.google.com/maps/search/?api=1&query=Jl.+Raya+Abdul+Gani+No.48%2C+RT.006%2FRW.001%2C+Kalibaru%2C+Kec.+Cilodong%2C+Kota+Depok%2C+Jawa+Barat+16414"
            target="_blank"
            rel="noopener noreferrer"
          >
            Jl. Raya Abdul Gani No.48, RT.006/RW.001, Kalibaru, Kec. Cilodong, Kota Depok, Jawa Barat 16414
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Cave of Chi • Art. Space. Energy.</span>
      <span class="footer-note">{translate(locale, 'Pilih pengalaman, cek jadwal, dan pesan tempat langsung melalui website.')}</span>
      <a href="#main">{translate(locale, 'Back to top ↑')}</a>
    </div>
  </div>
</footer>
<style>
  .footer {
    padding: 70px 0 23px;
    background: #3d3029;
    color: var(--paper-light);
  }

  .footer-upper,
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer-upper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: start;
  }

  .footer-caption {
    max-width: 320px;
    margin-top: 30px;
    color: #e9d7c6;
    font-family: var(--font-heading);
    font-size: 33px;
    line-height: 1.1;
  }

  .footer-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    max-width: 360px;
    margin-left: auto;
  }

  .footer-links > div {
    display: block;
    min-width: 130px;
    color: #d3bdab;
    font-size: 12px;
  }

  .footer-links strong {
    display: block;
    margin-bottom: 17px;
    color: #f4e9dc;
    font-size: 10px;
    letter-spacing: 0.2em;
    line-height: normal;
    text-transform: uppercase;
  }

  .footer-links a,
  .footer-links span {
    display: block;
    color: #d3bdab;
    font-size: 12px;
    line-height: 2.3;
  }

  .footer-bottom {
    align-items: center;
    gap: 12px;
    margin-top: 60px;
    padding-top: 20px;
    border-top: 1px solid #786555;
    color: #c7b5a4;
    font-size: 10px;
    letter-spacing: 0.07em;
    line-height: normal;
  }

  .footer-note {
    max-width: 300px;
  }

  @media (max-width: 740px) {
    .footer-upper,
    .footer-bottom {
      flex-direction: column;
      gap: var(--space-3);
    }

    .footer-upper {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .footer-links {
      width: 100%;
      margin-left: 0;
    }

    .footer-bottom {
      align-items: flex-start;
      margin-top: var(--space-4);
    }
  }
</style>