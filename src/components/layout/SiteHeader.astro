---
import Brand from '@/components/layout/Brand.astro';
import { NAV_LINKS } from '@/lib/site';
import { localizedPath, translate } from '@/lib/i18n';
interface Props { variant?: 'overlay' | 'solid' }
const { variant = 'overlay' } = Astro.props;
const locale = Astro.locals.locale;
const path = Astro.locals.localePath;
const normalizedPath = path.split(/[?#]/, 1)[0].replace(/^\/en(?=\/|$)/, '') || '/';
const isCurrent = (href: string) =>
  !href.includes('#') && (href === normalizedPath || normalizedPath.startsWith(href + '/'));
---
<header class:list={['header', variant]}>
  <Brand />
  <nav class="nav" id="site-nav" aria-label={translate(locale, 'Navigasi utama')}>
    {NAV_LINKS.map((l) => (
      <a href={localizedPath(locale, l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{translate(locale, l.label)}</a>
    ))}
    <a class="nav-book" href={localizedPath(locale, '/experiences')} data-book>{translate(locale, 'Pesan tempat ↗')}</a>
  </nav>
  <div class="language-switcher" role="group" aria-label={locale === 'en' ? 'Choose language' : 'Pilih bahasa'}>
    <a href={localizedPath('id', path)} lang="id" hreflang="id"
      aria-current={locale === 'id' ? 'page' : undefined}
      aria-label="Bahasa Indonesia" title="Bahasa Indonesia">ID</a>
    <span aria-hidden="true">/</span>
    <a href={localizedPath('en', path)} lang="en" hreflang="en"
      aria-current={locale === 'en' ? 'page' : undefined}
      aria-label="English" title="English">EN</a>
  </div>
  <button class="menu-btn" type="button" aria-label={locale === 'en' ? 'Open navigation' : 'Buka navigasi'}
          aria-expanded="false" aria-controls="site-nav">☰</button>
</header>

<style>
  .header {
    position: absolute;
    z-index: 30;
    top: 38px;
    left: 0;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 24px max(24px, calc((100vw - var(--content-width)) / 2));
  }

  .header.solid {
    position: relative;
    top: 0;
    background: var(--umber);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: normal;
  }

  .language-switcher {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 7px;
    margin-left: 22px;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .language-switcher a {
    padding: 5px 2px;
    opacity: 0.68;
    transition: opacity 180ms ease;
  }

  .language-switcher a:hover,
  .language-switcher a[aria-current="page"] {
    opacity: 1;
  }

  .language-switcher a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .nav a:not(.nav-book) {
    opacity: 0.91;
    transition: opacity 180ms ease;
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    opacity: 0.6;
  }

  .nav-book {
    display: inline-block;
    padding: 13px 21px;
    border: 0;
    background: #f5ece4;
    color: #3f2d23;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 200ms ease;
    cursor: pointer;
  }

  .nav-book:hover {
    background: #dac3a8;
  }

  .menu-btn {
    display: none;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 23px;
    line-height: normal;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .header {
      top: 34px;
      padding: 18px;
    }

    .header.solid {
      top: 0;
    }

    .menu-btn {
      display: inline-block;
    }

    .language-switcher {
      margin: 0 0 0 auto;
    }

    .nav {
      position: absolute;
      top: 100%;
      right: 12px;
      left: 12px;
      display: none;
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      padding: 10px 18px;
      border-radius: var(--radius-md);
      background: var(--umber);
      box-shadow: var(--shadow-card);
    }

    .nav.open {
      display: flex;
    }

    .nav a {
      padding: 13px 0;
    }

    .nav .nav-book {
      margin-top: 6px;
      padding: 13px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav a:not(.nav-book),
    .language-switcher a {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  if (btn && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
    nav.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  }
</script>