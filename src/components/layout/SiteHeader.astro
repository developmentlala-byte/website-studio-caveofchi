---
import Brand from '@/components/layout/Brand.astro';
import { NAV_LINKS } from '@/lib/site';

interface Props { variant?: 'overlay' | 'solid' }
const { variant = 'overlay' } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  !href.includes('#') && (href === path || path.startsWith(href + '/'));
---
<header class:list={['header', variant]}>
  <Brand />
  <nav class="nav" id="site-nav" aria-label="Navigasi utama">
    {NAV_LINKS.map((l) => (
      <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <a class="nav-book" href="/experiences" data-book>Pesan tempat ↗</a>
  </nav>
  <button class="menu-btn" type="button" aria-label="Buka navigasi"
          aria-expanded="false" aria-controls="site-nav">☰</button>
</header>

<style>
  .header {
    position: absolute;
    z-index: 30;
    top: 38px;
    left: 0;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 24px max(24px, calc((100vw - var(--content-width)) / 2));
  }

  .header.solid {
    position: relative;
    top: 0;
    background: var(--umber);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: normal;
  }

  .nav a:not(.nav-book) {
    opacity: 0.91;
    transition: opacity 180ms ease;
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    opacity: 0.6;
  }

  .nav-book {
    display: inline-block;
    padding: 13px 21px;
    border: 0;
    background: #f5ece4;
    color: #3f2d23;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 200ms ease;
    cursor: pointer;
  }

  .nav-book:hover {
    background: #dac3a8;
  }

  .menu-btn {
    display: none;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 23px;
    line-height: normal;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .header {
      top: 34px;
      padding: 18px;
    }

    .header.solid {
      top: 0;
    }

    .menu-btn {
      display: inline-block;
    }

    .nav {
      position: absolute;
      top: 100%;
      right: 12px;
      left: 12px;
      display: none;
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      padding: 10px 18px;
      border-radius: var(--radius-md);
      background: var(--umber);
      box-shadow: var(--shadow-card);
    }

    .nav.open {
      display: flex;
    }

    .nav a {
      padding: 13px 0;
    }

    .nav .nav-book {
      margin-top: 6px;
      padding: 13px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav a:not(.nav-book) {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  if (btn && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
    nav.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  }
</script>