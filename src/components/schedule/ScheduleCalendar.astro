---
import BookButton from '@/components/booking/BookButton.astro';
import type { CaveEvent } from '@/lib/events';
import { translate } from '@/lib/i18n';
import { dayKey, formatDateShort, formatDayNumber, formatIDR, formatMonthRange, formatSeatsLeft, formatTime, formatWeekday } from '@/lib/format';

interface Props { events: CaveEvent[] }
const { events } = Astro.props;
const locale = Astro.locals.locale;
type EventSession = CaveEvent['data']['sessions'][number];
const slots = events.flatMap((event) =>
  event.data.sessions.map((session) => ({ event, session })),
).sort((a, b) => a.session.startsAt.getTime() - b.session.startsAt.getTime());
const salesLabel = (session: EventSession) => {
  if (session.salesStatus === 'coming_soon') {
    return session.registrationOpensAt
      ? `${translate(locale, 'Penjualan dibuka')} ${formatDateShort(session.registrationOpensAt, locale)}`
      : translate(locale, 'Penjualan segera dibuka');
  }
  if (session.salesStatus === 'sold_out') return translate(locale, 'Kuota habis');
  if (session.salesStatus === 'closed') return translate(locale, 'Pendaftaran ditutup');
  return formatSeatsLeft(session.seatsLeft, locale);
};
const grouped = new Map<string, Array<(typeof slots)[number]>>();
for (const slot of slots) {
  const key = dayKey(slot.session.startsAt);
  const group = grouped.get(key);
  if (group) group.push(slot);
  else grouped.set(key, [slot]);
}
const days = [...grouped.entries()];
const range = slots.length
  ? formatMonthRange(slots[0].session.startsAt, slots[slots.length - 1].session.startsAt, locale)
  : '';
---
<div class="calendar-card" data-schedule>
  <div class="calendar-top"><strong>{range || translate(locale, 'Jadwal')}</strong></div>
  {days.length === 0 ? (
    <p class="agenda-empty">{translate(locale, 'Belum ada kelas terjadwal.')}</p>
  ) : (
    <>
      <div class="calendar-pills" role="group" aria-label={translate(locale, 'Pilih tanggal kelas')}>
        {days.map(([key, items], i) => (
          <button type="button" class:list={['date-pill', { active: i === 0 }]}
            data-date={key} aria-pressed={i === 0 ? "true" : "false"}>
            <small>{formatWeekday(items[0].session.startsAt)}</small>
            <strong>{formatDayNumber(items[0].session.startsAt)}</strong>
          </button>
        ))}
      </div>
      {days.map(([key, items], i) => (
        <div class="agenda" data-agenda={key} hidden={i !== 0}>
          {items.map(({ event, session }) => (
            <div class="agenda-item">
              <span class="time">{formatTime(session.startsAt)} WIB</span>
              <div>
                <strong>{event.data.title}</strong>
                <small>{session.studioName} · {formatIDR(session.price)} · <span data-seats-left={session.sessionId}>{salesLabel(session)}</span></small>
              </div>
              <div class="agenda-action">
                <BookButton event={event} session={session} variant="outline">
                    {session.isBookable ? translate(locale, 'Pesan sekarang ↗') : session.salesStatus === 'coming_soon' ? translate(locale, 'Segera dibuka') : session.salesStatus === 'sold_out' ? translate(locale, 'Kuota habis') : translate(locale, 'Pendaftaran ditutup')}
                </BookButton>
              </div>
            </div>
          ))}
        </div>
      ))}
    </>
  )}
</div>

<style>
  .calendar-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-light);
  }

  .calendar-top {
    padding: 18px 22px;
    background: var(--umber);
    color: var(--paper-light);
    font-family: var(--font-heading);
    font-size: 24px;
  }

  .calendar-pills {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
  }

  .date-pill {
    display: grid;
    min-width: 64px;
    gap: 5px;
    padding: 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .date-pill small {
    font-size: 9px;
    text-transform: uppercase;
  }

  .date-pill strong {
    color: var(--umber);
    font-family: var(--font-heading);
    font-size: 25px;
    font-weight: 500;
  }

  .date-pill.active {
    border-color: var(--umber);
    background: var(--umber);
    color: var(--paper-light);
  }

  .date-pill.active strong {
    color: var(--paper-light);
  }

  .agenda {
    padding-inline: 22px;
  }

  .agenda-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .agenda-item:last-child {
    border-bottom: 0;
  }

  .agenda-item .time {
    min-width: 78px;
    color: var(--clay);
    font-size: 12px;
    font-weight: 600;
  }

  .agenda-item > div:nth-child(2) {
    display: grid;
    gap: 4px;
  }

  .agenda-item strong {
    color: var(--umber);
    font-family: var(--font-heading);
    font-size: 21px;
    font-weight: 500;
  }

  .agenda-item small {
    color: var(--muted);
    font-size: 10px;
  }

  .agenda-action {
    margin-left: auto;
  }

  .agenda-empty {
    padding: 24px;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .agenda,
    .calendar-pills {
      padding-inline: 14px;
    }

    .agenda-item {
      align-items: start;
      flex-wrap: wrap;
      gap: 10px 14px;
    }

    .agenda-action {
      margin-left: 92px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-schedule]').forEach((root) => {
    const pills = root.querySelectorAll<HTMLButtonElement>('[data-date]');
    const panels = root.querySelectorAll<HTMLElement>('[data-agenda]');
    pills.forEach((pill) =>
      pill.addEventListener('click', () => {
        pills.forEach((p) => {
          const on = p === pill;
          p.classList.toggle('active', on);
          p.setAttribute('aria-pressed', String(on));
        });
        panels.forEach((panel) => (panel.hidden = panel.dataset.agenda !== pill.dataset.date));
      }),
    );
  });
</script>