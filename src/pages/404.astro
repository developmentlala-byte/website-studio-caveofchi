---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localizedPath, translate } from "@/lib/i18n";
const locale = Astro.locals.locale;
---
<BaseLayout
  title="Halaman tidak ditemukan — Cave of Chi"
  description="Halaman yang kamu cari tidak tersedia."
  noindex
>
  <section class="not-found section container">
    <div class="eyebrow">404 / {translate(locale, 'Halaman tidak ditemukan')}</div>
    <h1 class="heading">{locale === 'en' ? <>Let's find<br /><em class="script">our way back.</em></> : <>Ayo cari<br /><em class="script">jalan pulang.</em></>}</h1>
    <a href={localizedPath(locale, '/')}>{translate(locale, 'Kembali ke beranda')} <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 55vh;
  }

  .not-found .heading {
    margin: 18px 0 30px;
  }

  .not-found a {
    display: inline-flex;
    gap: 14px;
    color: var(--umber);
    font-size: 12px;
  }
</style>
