---
import { getCollection } from "astro:content";
import Gallery from "@/components/common/Gallery.astro";
import BookButton from "@/components/booking/BookButton.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDateShort, formatDuration, formatIDR, formatSeatsLeft, formatTime } from "@/lib/format";
import { getCategoryLabel } from "@/lib/site";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const data = event.data;
type EventSession = typeof data.sessions[number];
const sessions: EventSession[] = data.sessions.length > 0
  ? data.sessions
  : [{
      sessionId: data.eventId,
      startsAt: data.startsAt,
      durationMinutes: data.durationMinutes,
      price: data.price,
      capacity: data.capacity,
      seatsLeft: data.seatsLeft,
      space: data.space,
      studioName: data.studioName,
    }];
const gallery = [
  ...(data.imageUrl
    ? [{ url: data.imageUrl, altText: `Suasana ${data.title}` }]
    : []),
  ...data.images,
].filter((image, index, images) =>
  images.findIndex((candidate) => candidate.url === image.url) === index,
);
const isPast = data.startsAt.getTime() < Date.now();
const endsAt = new Date(data.startsAt.getTime() + data.durationMinutes * 60_000);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Event",
  name: data.title,
  description: data.subtitle,
  startDate: data.startsAt.toISOString(),
  endDate: endsAt.toISOString(),
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: { "@type": "Place", name: data.studioName },
  offers: { "@type": "Offer", price: data.price, priceCurrency: "IDR" },
}).replace(/</g, "\\u003c");
---
<BaseLayout title={`${data.title} — Cave of Chi`} description={data.subtitle}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <article class="detail section container">
    <a class="back-link" href="/experiences">← Semua experiences</a>
    <div class="eyebrow">{getCategoryLabel(data.category)}</div>
    <h1 class="heading">{data.title}</h1>
    <p class="lead">{data.subtitle}</p>
    <Gallery images={gallery} label={data.title} />

    <dl class="facts">
      <div><dt>Jadwal</dt><dd>{sessions.length} sesi</dd></div>
      <div><dt>Durasi</dt><dd>{formatDuration(data.durationMinutes)}</dd></div>
      <div><dt>Tempat</dt><dd>{data.studioName}</dd></div>
      <div><dt>Mulai dari</dt><dd>{formatIDR(Math.min(...sessions.map((session) => session.price)))}</dd></div>
    </dl>

    {data.description?.split("\n\n").map((paragraph) => <p class="description">{paragraph}</p>)}
    {data.included.length > 0 && (
      <>
        <h2>Sudah termasuk</h2>
        <ul>{data.included.map((item) => <li>{item}</li>)}</ul>
      </>
    )}

    <h2>Jadwal &amp; ketersediaan</h2>
    <div class="detail-sessions">
      {sessions.map((session) => (
        <div class="detail-session">
          <div class="session-info">
            <strong>{formatDateShort(session.startsAt)} · {formatTime(session.startsAt)} WIB</strong>
            <small>{session.studioName} · {formatDuration(session.durationMinutes)} · <span data-seats-left={session.sessionId}>{formatSeatsLeft(session.seatsLeft)}</span></small>
          </div>
          <div class="session-offer">
            <strong>{formatIDR(session.price)}</strong>
            {isPast
              ? <span class="micro">Event ini sudah berlangsung.</span>
              : <BookButton event={event} session={session}>Pesan ↗</BookButton>}
          </div>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 28px;
    color: var(--muted);
    font-size: 12px;
  }

  .detail .heading {
    margin: 12px 0;
  }

  .lead {
    margin: 0 0 24px;
    color: var(--muted);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 26px 0;
    padding: 20px 0;
    border-block: 1px solid var(--line);
  }

  .facts div {
    display: grid;
    gap: 5px;
  }

  .facts dt {
    color: var(--muted);
    font-size: 10px;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
    color: var(--umber);
    font-size: 13px;
  }

  .description {
    max-width: 720px;
    color: var(--muted);
    line-height: 1.8;
  }

  .detail h2 {
    color: var(--umber);
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 500;
  }

  .detail-sessions {
    border-top: 1px solid var(--line);
  }

  .detail-session {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .session-info,
  .session-offer {
    display: grid;
    gap: 7px;
  }

  .session-info strong,
  .session-offer strong {
    color: var(--umber);
    font-size: 13px;
  }

  .session-info small {
    color: var(--muted);
    font-size: 11px;
  }

  .session-offer {
    justify-items: end;
  }

  .detail ul {
    margin-bottom: 24px;
    color: var(--muted);
    line-height: 1.9;
  }

  @media (max-width: 740px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }

    .detail-session {
      align-items: start;
      flex-direction: column;
    }

    .session-offer {
      width: 100%;
      align-items: center;
      justify-items: start;
      grid-template-columns: 1fr auto;
    }
  }
</style>
